+# - markdown 用 glow 插件渲染预览、目录用 eza 插件树状预览（plugins/ 已随仓库入库）
+# - git 角标三件套缺一不可：本文件 prepend_fetchers + init.lua 的
+#   require("git"):setup + theme.toml [git] 段配色
+# - .md 的 mime 实测是 text/plain 而非 text/markdown，规则必须加 url 兜底
+# - yazi 26.9.1 对目录的 mime 判定是 "folder/*"，不是 inode/directory
 
 [mgr]
-ratio = [1, 4, 3]
-sort_by = "natural"
-sort_sensitive = false
